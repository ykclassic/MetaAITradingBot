# XT.com credentials
XT_API_KEY=
XT_SECRET_KEY=

# Optional Supabase persistence
SUPABASE_URL=
SUPABASE_KEY=

# Trading
TRADE_SYMBOLS=BTC_USDT,ETH_USDT,SOL_USDT,BNB_USDT,XRP_USDT,ADA_USDT,LINK_USDT
TIMEFRAME=M15
RISK_PER_TRADE_PCT=0.01
MAX_DAILY_DRAWDOWN_PCT=0.05
MAX_OPEN_POSITIONS=3
CONTRACT_SIZE=1.0

# Model
MODEL_VERSION=v1.0.0
MODEL_DIR=models/
MODEL_CONFIDENCE_THRESHOLD=0.65

# Runtime
LOOKBACK_PERIODS=100
CYCLE_INTERVAL_SECONDS=60
RUN_ONCE=true
LIVE_TRADING_ENABLED=false

# Operations monitoring (use a Discord channel webhook URL; keep it in GitHub Secrets)
DISCORD_WEBHOOK_URL=

# Trading journal / performance tracker
PERFORMANCE_DB_PATH=data/trading_system.sqlite
